
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles
enum UserRole {
  donor
  organizer
  reviewer
}

// Campaign status
enum CampaignStatus {
  draft
  active
  completed
  cancelled
}

// Milestone status
enum MilestoneStatus {
  open
  evidence_submitted
  approved
  rejected
  paid
}

// Donation status
enum DonationStatus {
  pending
  completed
  failed
  refunded
}
enum RefundStatus {
  processing
  pending
  completed
  failed
  cancelled
  reconciliation_required
}

// Evidence review decision
enum ReviewerDecision {
  pending
  approved
  rejected
}

// Payout status
enum PayoutStatus {
  pending
  processing
  paid
  failed
  reconciliation_required
}

// 1. User
model User {
  id    String   @id @default(uuid()) @db.Uuid
  role  UserRole
  name  String
  email String   @unique

  campaigns Campaign[] @relation("OrganizerCampaigns")
  donations Donation[]
}

// 2. Organization
model Organization {
  id                  String    @id @default(uuid()) @db.Uuid
  name                String
  cause               String
  location            String
  payoutEmail         String?
  verified            Boolean   @default(false)
  trustScore          Int       @default(0)
  trustScoreBreakdown Json?
  trustScoreUpdatedAt DateTime? @db.Timestamptz(3)

  campaigns Campaign[]
}

// 3. Campaign
model Campaign {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  organizerId     String?        @db.Uuid
  title           String
  goalAmountCents Int
  currency        String         @default("USD")
  status          CampaignStatus @default(draft)

  organization Organization @relation(fields: [organizationId], references: [id])
  organizer    User?        @relation("OrganizerCampaigns", fields: [organizerId], references: [id])
  milestones   Milestone[]
  donations    Donation[]
}

// 4. Milestone
model Milestone {
  id                String          @id @default(uuid()) @db.Uuid
  campaignId        String          @db.Uuid
  title             String
  budgetAmountCents Int
  status            MilestoneStatus @default(open)
  dueDate           DateTime?       @db.Timestamptz(3)

  campaign Campaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  evidence Evidence[]
  payout   Payout?
}

// 5. Donation
model Donation {
  id              String         @id @default(uuid()) @db.Uuid
  campaignId      String         @db.Uuid
  donorId         String         @db.Uuid
  amountCents     Int
  paypalOrderId   String?        @unique
  paypalCaptureId String?        @unique
  status          DonationStatus @default(pending)
  completedAt     DateTime?      @db.Timestamptz(3)
  refunds Refund[]
  campaign Campaign @relation(fields: [campaignId], references: [id])
  donor    User     @relation(fields: [donorId], references: [id])
}
// Tracks individual PayPal refunds against a donation.
model Refund {
  id             String       @id @default(uuid()) @db.Uuid
  donationId     String       @db.Uuid
  idempotencyKey String
  paypalRefundId String?      @unique
  amountCents    Int
  status         RefundStatus @default(processing)
  noteToPayer    String?
  failureReason  String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)
  completedAt    DateTime?    @db.Timestamptz(3)

  donation Donation @relation(fields: [donationId], references: [id])

  @@unique([donationId, idempotencyKey])
  @@index([donationId, status])
}

// 6. Evidence
model Evidence {
  id               String           @id @default(uuid()) @db.Uuid
  milestoneId      String           @db.Uuid
  file             String
  extractedFields  Json
  aiFindings       Json
  reviewerDecision ReviewerDecision @default(pending)
  submittedAt      DateTime         @default(now()) @db.Timestamptz(3)

  milestone Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
}

// 7. Payout
model Payout {
  id                         String       @id @default(uuid()) @db.Uuid
  milestoneId                String       @unique @db.Uuid
  amountCents                Int
  senderBatchId              String?      @unique
  paypalBatchId              String?      @unique
  status                     PayoutStatus @default(pending)

  // Tracks when the current submission attempt began.
  submissionAttemptStartedAt DateTime?    @db.Timestamptz(3)

  // Tracks when the payout provider confirmed submission acceptance.
  submittedAt                DateTime?    @db.Timestamptz(3)

  milestone Milestone @relation(fields: [milestoneId], references: [id])

  @@index([status, submissionAttemptStartedAt])
}

// 8. Ledger Event
model LedgerEvent {
  id        String   @id @default(uuid()) @db.Uuid
  type      String
  entityId  String   @db.Uuid
  payload   Json
  prevHash  String?
  hash      String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([entityId, createdAt])
}

// PayPal webhook events — prevents duplicate processing
model WebhookEvent {
  id               String    @id @default(uuid()) @db.Uuid
  paypalEventId    String    @unique
  eventType        String
  resourceId       String?
  payload          Json

  processingStatus String    @default("received")
  lastError        String?

  receivedAt       DateTime  @default(now()) @db.Timestamptz(3)
  processedAt      DateTime? @db.Timestamptz(3)

  @@index([eventType, receivedAt])
  @@index([processingStatus, receivedAt])
}