# Database & Auth
# Default connection string matching docker-compose.yml:
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/impactledger?schema=public"
JWT_SECRET="dev-jwt-secret-replace-in-production-abcdef123456"

# API & Frontend Servers
PORT=3000
FRONTEND_URL="http://localhost:5173"

# AI Engine (packages/ai)
# Set AI_MODE=mock to run without an AI key (ideal for judges evaluating canned receipts & routing)
# Set AI_MODE=live and provide AI_API_KEY (Google Gemini API key) for live Gemini 2.5 Flash inference
AI_MODE=mock
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=

# PayPal API (Sandbox)
# Get sandbox credentials at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID="replace-with-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="replace-with-paypal-sandbox-client-secret"
PAYPAL_WEBHOOK_ID=
