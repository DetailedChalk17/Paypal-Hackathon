# Database & Auth
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/impactledger?schema=public"
JWT_SECRET="replace-with-a-random-secret"

# API Server
PORT=3000
FRONTEND_URL="http://localhost:5173"

# AI package (packages/ai). Get a key at Google AI Studio.
# Put the real key in .env (git-ignored), never in this file.
AI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash

# PayPal API (Sandbox)
PAYPAL_CLIENT_ID="replace-with-paypal-sandbox-client-id"
PAYPAL_CLIENT_SECRET="replace-with-paypal-sandbox-client-secret"
PAYPAL_WEBHOOK_ID=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_ENV=sandbox
